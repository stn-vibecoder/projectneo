# Kopier til .env.local og fyll inn. .env.local skal ALDRI sjekkes inn i git.

# --- Database på nett (Vercel / Supabase) ---------------------------------
# Uten disse kjører appen i LOKAL MODUS med databasen i .data/ (anbefalt på Macen).
# På Vercel legger «Storage → Supabase» inn POSTGRES_URL automatisk.
# Alternativt: DATABASE_URL = Supabase → Connect → «Transaction pooler».
DATABASE_URL=
# Antall samtidige databasekoblinger per serverinstans:
DB_POOL_MAX=3

# --- Innlogging (AV som standard) ---------------------------------------
# true = krev innlogging med Supabase Auth. Krever nøklene under og ALLOWED_EMAILS.
NEXT_PUBLIC_REQUIRE_LOGIN=false
# Kommaseparert liste over e-poster som får logge inn når innlogging er på:
ALLOWED_EMAILS=
# Vis «Fortsett med Google» (krever Google-oppsett i Supabase):
NEXT_PUBLIC_GOOGLE_LOGIN=false

# --- Supabase (Project Settings -> API) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# "Publishable key" (sb_publishable_...) eller den eldre "anon"-nøkkelen
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Kun på serveren (brukes fra fase 2 til automatisk henting). Aldri NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ------------------------------------------------------------------
# Brukes i e-postlenker og OAuth-redirect. Lokalt: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Fase 2: datakilder (alle valgfrie) -------------------------------------
# NAV: uten egen token brukes NAVs offentlige testtoken (byttes jevnlig).
# Egen token: send e-post til nav.team.arbeidsplassen@nav.no (se README).
NAV_FEED_TOKEN=
# Adzuna (London/New York): gratis nøkkel på https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Slå av henting fra NHHS og Bindeleddet (bare til personlig bruk):
STUDENT_PORTALS_ENABLED=true
# Slå av automatisk henting hver 6. time mens appen kjører:
DISABLE_AUTO_INGEST=false
# Vercel Cron henter alle kilder én gang i døgnet (kl. 06/07 norsk tid, se vercel.json).
# Sett en lang, tilfeldig tekst her OG i Vercel, ellers avvises hentingen.
CRON_SECRET=

# --- Fase 3: søknadstips (valgfritt; uten nøkkel brukes eksempeltips) -------
ANTHROPIC_API_KEY=
AI_TIPS_DAILY_LIMIT=10
